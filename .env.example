# BotFather bergan token
BOT_TOKEN=

# Serveringizning HTTPS manzili (oxirida / belgisisiz)
PUBLIC_URL=https://bura-example.onrender.com

# BotFather /newapp da kiritgan qisqa nom
APP_SHORT_NAME=bura

# Har yurishga beriladigan vaqt (soniya)
TURN_SECONDS=30

# webhook yoki polling (boʻsh qoldirsangiz, avtomatik tanlanadi)
BOT_MODE=

PORT=3000

# 1 — Telegramsiz brauzerda sinash (faqat oʻz kompyuteringizda!)
DEV_MODE=0

# --- Ovozli chat (ixtiyoriy) ---
# TURN server: mobil internetda ulanish ishonchli boʻlishi uchun tavsiya etiladi.
# Masalan, Metered Open Relay (bepul): roʻyxatdan oʻtib, bergan login va parolni yozing.
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Yoki toʻliq roʻyxat JSON koʻrinishida (bu berilsa, yuqoridagilar eʼtiborsiz qoladi):
# ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"...","credential":"..."}]
# STUN serverlar (berilmasa — Google va Cloudflare)
# STUN_URLS=stun:stun.l.google.com:19302
# 1 — ovoz faqat TURN orqali oʻtadi, oʻyinchilar bir-birining IP manzilini koʻrmaydi (TURN shart)
# VOICE_RELAY_ONLY=0
